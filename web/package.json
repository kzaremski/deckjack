{
  "name": "deckjack-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Deckjack's browser shell: windows, dock and command palette. Built to a plain static bundle that rust-embed bakes into the core binary.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "tokens": "node --experimental-strip-types scripts/emit-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "15.11.7",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "^3.2.4",
    "vue-tsc": "2.2.0"
  }
}
