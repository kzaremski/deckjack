{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/tokens/types.ts",
    "src/tokens/foundation.ts",
    "src/tokens/registry.ts",
    "src/tokens/css.ts",
    "src/tokens/themes/**/*.ts"
  ]
}
